{
  "name": "resona",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "render": "node --no-warnings --experimental-strip-types scripts/render.ts",
    "deploy:audio-preview": "wrangler deploy --env preview",
    "test:audio": "node --test tests/audio-wallet.test.mjs tests/audio-api.test.mjs tests/res-auth.test.mjs tests/audio-generation.test.mjs tests/stability-audio.test.mjs tests/gemini-lyria.test.mjs tests/cloudflare-sfx.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "^4.151.2"
  }
}
